def per_user_metrics(ranks_list):
    # trung bình theo seed của HR@10 / NDCG@10 theo từng khách hàng
    hr = np.mean([(r <= 10).astype(np.float64) for r in ranks_list], axis=0)
    nd = np.mean([np.where(r <= 10, 1.0 / np.log2(r + 1), 0.0) for r in ranks_list], axis=0)
    return hr, nd


def ranks_from_scores(scores, priorities=None):
    # scores: (U, 101), cột 0 là sản phẩm dương. priorities=None: validation (strict >), có priorities: test
    better = scores[:, 1:] > scores[:, :1]
    if priorities is not None:
        pr = np.asarray(priorities)
        better = better | ((scores[:, 1:] == scores[:, :1]) & (pr[:, 1:] < pr[:, :1]))
    return 1 + better.sum(axis=1)


def ndcg_hr_from_ranks(r):
    r = np.asarray(r)
    return float(np.mean(r <= 10)), float(np.mean(np.where(r <= 10, 1.0 / np.log2(r + 1), 0.0)))


def zscore_rows(s):
    s = np.asarray(s, np.float32)
    return (s - s.mean(axis=1, keepdims=True)) / (s.std(axis=1, keepdims=True) + 1e-8)


def simplex_grid(k, step):
    # mọi bộ trọng số không âm có tổng = 1 với bước `step` (k thành phần)
    n = int(round(1 / step))
    def rec(left, parts):
        if parts == 1:
            yield (left,)
            return
        for i in range(left + 1):
            for rest in rec(left - i, parts - 1):
                yield (i,) + rest
    return [tuple(v / n for v in c) for c in rec(n, k)]


def tune_weights(valid_z, step, priorities):
    # chọn trọng số tối đa hóa NDCG@10 trên VALIDATION (không dùng test).
    # BẮT BUỘC dùng phá hòa chung của validation: điểm Item-CF có ~95% ứng viên bằng 0, nếu không phá hòa
    # thì sản phẩm dương có điểm 0 tự xếp hạng 1 và HR@10 bị thổi phồng.
    best, best_w = -1.0, None
    for w in simplex_grid(len(valid_z), step):
        fused = sum(wi * z for wi, z in zip(w, valid_z) if wi > 0)
        nd = ndcg_hr_from_ranks(ranks_from_scores(fused, priorities))[1]
        if nd > best:
            best, best_w = nd, w
    return best_w, best


def build_variant(allowed):
    # Giữ lại chỉ một số loại hành vi (ví dụ {1, 2} = view + addtocart), dựng lại chuỗi train và đầu vào đánh giá
    allowed = np.asarray(sorted(allowed))
    tr = {u: (i[np.isin(b, allowed)], b[np.isin(b, allowed)]) for u, (i, b) in mb_train.items()}
    n = len(eval_users)
    vs, vb = np.zeros((n, MAXLEN), np.int32), np.zeros((n, MAXLEN), np.int32)
    ts, tb = np.zeros((n, MAXLEN), np.int32), np.zeros((n, MAXLEN), np.int32)
    for row, u in enumerate(eval_users):
        i_, b_ = tr[int(u)];  vs[row], vb[row] = left_pad_np(i_), left_pad_np(b_)
        i_, b_ = mb_test_hist[int(u)]
        m = np.isin(b_, allowed)
        ts[row], tb[row] = left_pad_np(i_[m]), left_pad_np(b_[m])
    users = np.asarray([u for u, (i, _) in tr.items() if len(i) > 1], dtype=np.int64)
    return dict(seqs=tr, users=users, valid=(vs, vb), test=(ts, tb))



# ======================= 4.3.4.9. KẾT HỢP NHIỀU THUẬT TOÁN (HYBRID) =======================
# Kết hợp tuyến tính điểm đã chuẩn hóa z-score theo từng khách hàng trên 101 ứng viên.
# Trọng số chọn trên VALIDATION (không dùng test). Mỗi seed có một bộ trọng số riêng.
from scipy.sparse import load_npz, csr_matrix

def itemcf_scores(H, S, cand_cols, batch=256):
    # điểm Item-CF của 101 ứng viên (cùng cách tính với notebook của nhóm), trả về (U, 101) float32
    out = np.zeros(cand_cols.shape, dtype=np.float32)
    for start in range(0, H.shape[0], batch):
        end = min(start + batch, H.shape[0])
        sm = (H[start:end] @ S).tocsr()
        sm.sort_indices()
        for j in range(end - start):
            a, b = sm.indptr[j], sm.indptr[j + 1]
            items, vals = sm.indices[a:b], sm.data[a:b]
            cand = cand_cols[start + j]
            pos = np.searchsorted(items, cand)
            ok = pos < len(items)
            idx = np.flatnonzero(ok)
            if len(idx):
                hit = items[pos[idx]] == cand[idx]
                out[start + j, idx[hit]] = vals[pos[idx[hit]]]
        del sm
    return out

if RUN_HYBRID:
    t0 = time.time()
    Sm = load_npz(os.path.join(ITEMCF_DIR, "item_similarity_shared.npz")).tocsr()
    Xm = load_npz(os.path.join(ITEMCF_DIR, "user_item_binary_shared.npz")).tocsr()
    catalog = np.load(os.path.join(ITEMCF_DIR, "item_catalog_shared.npy"))
    user_ids = np.load(os.path.join(ITEMCF_DIR, "user_ids_shared.npy"))
    raw_valid_c = np.load(os.path.join(EVAL_DIR, "valid_candidates_shared.npy"))
    raw_test_c = np.load(os.path.join(EVAL_DIR, "test_candidates_shared.npy"))
    rows_u = np.searchsorted(user_ids, eval_users)
    assert np.array_equal(user_ids[rows_u], eval_users)
    H_train = Xm[rows_u].tocsr()
    v_cols = np.searchsorted(catalog, raw_valid_c[:, 0])
    Vm = csr_matrix((np.ones(len(eval_users), np.int32), (np.arange(len(eval_users)), v_cols)), shape=H_train.shape)
    H_test = (H_train + Vm).tocsr(); H_test.data[:] = 1; H_test.eliminate_zeros(); H_test.sort_indices()

    icf_valid = itemcf_scores(H_train, Sm, np.searchsorted(catalog, raw_valid_c))
    icf_test = itemcf_scores(H_test, Sm, np.searchsorted(catalog, raw_test_c))
    # Kiểm tra: tính lại Item-CF phải trùng khớp từng khách hàng với thứ hạng đã lưu của nhóm
    chk = ranks_from_scores(icf_test, np.asarray(test_priorities))
    assert np.array_equal(chk, byname["Item-CF"]["ranks"][0].astype(chk.dtype)), "Điểm Item-CF không khớp kết quả của nhóm"
    print(f"Item-CF: điểm ứng viên đã dựng lại và khớp 100% thứ hạng của nhóm ({time.time() - t0:.0f}s)")
    del Sm, Xm, H_train, H_test; import gc; gc.collect()

    vpr, tpr = np.array(valid_priorities), np.array(test_priorities)        # nạp vào RAM một lần
    print(f"Item-CF trên validation (có phá hòa chung): HR@10 / NDCG@10 = "
          f"{ndcg_hr_from_ranks(ranks_from_scores(icf_valid, vpr))[0]:.4f} / {ndcg_hr_from_ranks(ranks_from_scores(icf_valid, vpr))[1]:.4f}")
    zi_valid, zi_test = zscore_rows(icf_valid), zscore_rows(icf_test)
    HYB = {   # tên phương án -> các thành phần
        "MB-SASRec + HSTU":              ["mb", "hstu"],
        "MB-SASRec + Item-CF":           ["mb", "icf"],
        "HSTU + Item-CF":                ["hstu", "icf"],
        "MB-SASRec + HSTU + Item-CF":    ["mb", "hstu", "icf"],
    }
    hyb_ranks = {k: [] for k in HYB}
    hyb_weights = {k: [] for k in HYB}
    for seed in SEEDS:
        zs_v, zs_t = {"icf": zi_valid}, {"icf": zi_test}
        for key, label in (("mb", "MB-SASRec (add)"), ("hstu", "HSTU")):
            spec = MODEL_SPECS[label]
            model = load_trained(spec, seed)
            vs, vb = DATA[spec["data"]]["valid"]; ts, tb = DATA[spec["data"]]["test"]
            zs_v[key] = zscore_rows(score_matrix_dl(model, vs, vb, valid_cand_idx))
            zs_t[key] = zscore_rows(score_matrix_dl(model, ts, tb, test_cand_idx))
            del model; torch.cuda.empty_cache()
        for name, comps in HYB.items():
            w, best_v = tune_weights([zs_v[c] for c in comps], 0.05 if len(comps) == 2 else 0.1, vpr)
            fused_t = sum(wi * zs_t[c] for wi, c in zip(w, comps) if wi > 0)
            r = ranks_from_scores(fused_t, tpr)
            hyb_ranks[name].append(r); hyb_weights[name].append(w)
            print(f"seed {seed} | {name:28s} | trọng số {dict(zip(comps, w))} | valid NDCG@10 {best_v:.4f} | "
                  f"TEST HR@10 {ndcg_hr_from_ranks(r)[0]:.4f} NDCG@10 {ndcg_hr_from_ranks(r)[1]:.4f}")
        del zs_v, zs_t

    rows = []
    for m in M5:
        rows.append({"Phương án": m["label"] + "  (đơn lẻ)", "Loại": "đơn lẻ", "HR@10": m["HR"], "NDCG@10": m["ND"]})
    hyb_user = {}
    for name in HYB:
        hs = [ndcg_hr_from_ranks(r) for r in hyb_ranks[name]]
        hyb_user[name] = per_user_metrics(hyb_ranks[name])
        rows.append({"Phương án": name + "  (kết hợp)", "Loại": "kết hợp", "HR@10": float(np.mean([h[0] for h in hs])),
                     "NDCG@10": float(np.mean([h[1] for h in hs])),
                     "HR@10 std": float(np.std([h[0] for h in hs], ddof=1)) if len(hs) > 1 else None,
                     "NDCG@10 std": float(np.std([h[1] for h in hs], ddof=1)) if len(hs) > 1 else None})
    hyb_df = pd.DataFrame(rows).sort_values("NDCG@10", ascending=False).reset_index(drop=True)
    print("\n===== 4.3.4.9  CHỌN MÔ HÌNH TỐT NHẤT vs KẾT HỢP NHIỀU THUẬT TOÁN (TEST) =====")
    print(hyb_df.round(6).to_string(index=False))
    hyb_df.to_csv(os.path.join(RESULTS_DIR, "ml3_hybrid_vs_single_HR_NDCG.csv"), index=False, encoding="utf-8-sig")

    best_hyb = max(HYB, key=lambda k: np.mean([ndcg_hr_from_ranks(r)[1] for r in hyb_ranks[k]]))
    d_nd, ci_nd = paired_bootstrap(hyb_user[best_hyb][1], byname[best_label]["user_nd"])
    d_hr, ci_hr = paired_bootstrap(hyb_user[best_hyb][0], byname[best_label]["user_hr"])
    print(f"\nKết hợp tốt nhất: {best_hyb}  so với mô hình đơn lẻ tốt nhất: {best_label}")
    print(f"  Δ HR@10 = {d_hr:+.4f} (CI95 [{ci_hr[0]:+.4f}, {ci_hr[1]:+.4f}]) | "
          f"Δ NDCG@10 = {d_nd:+.4f} (CI95 [{ci_nd[0]:+.4f}, {ci_nd[1]:+.4f}])")
    print("  Trọng số tối ưu theo từng seed:", {k: [tuple(round(x, 2) for x in w) for w in hyb_weights[k]] for k in [best_hyb]})
    print("\nLưu ý: SASRec của nhóm không nằm trong phần kết hợp vì chưa có điểm ứng viên được lưu (chỉ lưu thứ hạng).")

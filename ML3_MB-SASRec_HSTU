    d_nd, ci_nd = paired_bootstrap(byname[a]["user_nd"], byname[b]["user_nd"], n_boot)
    d_hr, ci_hr = paired_bootstrap(byname[a]["user_hr"], byname[b]["user_hr"], n_boot)
    sig = "có ý nghĩa" if (ci_nd[0] > 0 or ci_nd[1] < 0) else "chưa phân biệt được"
    return {"So sánh": f"{a} − {b}", "Δ HR@10": d_hr, "CI95 HR@10": f"[{ci_hr[0]:+.4f}, {ci_hr[1]:+.4f}]",
            "Δ NDCG@10": d_nd, "CI95 NDCG@10": f"[{ci_nd[0]:+.4f}, {ci_nd[1]:+.4f}]", "NDCG@10": sig}

pairs = [(best_label, o) for o in byname if o != best_label]
pairs += [("MB-SASRec (add)", "SASRec"), ("HSTU", "SASRec"), ("MB-SASRec (add)", "HSTU")]
seen, rows = set(), []
for a, b in pairs:
    if (a, b) in seen or (b, a) in seen:
        continue
    seen.add((a, b)); rows.append(compare_pair(a, b))
pair_df = pd.DataFrame(rows)
print("\n--- Paired bootstrap theo khách hàng (1.000 lần; chỉ phản ánh sai số lấy mẫu khách hàng, chưa gồm biến động seed) ---")
print(pair_df.round(4).to_string(index=False))
pair_df.to_csv(os.path.join(RESULTS_DIR, "ml3_pairwise_bootstrap.csv"), index=False, encoding="utf-8-sig")



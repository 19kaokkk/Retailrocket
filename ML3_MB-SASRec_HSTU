def get_mine(label):
    spec = MODEL_SPECS[label]
    fs = os.path.join(RESULTS_DIR, f"{spec['tag']}_test_summary_shared_fair_common.json")
    if not os.path.exists(fs):
        return None
    return get_model(label, RESULTS_DIR, os.path.basename(fs), seed_files(spec["tag"], spec["seeds"]))

def matched_full(full, m):
    # so biến thể với mô hình đầy đủ CÙNG seed (biến thể chạy 1 seed thì chỉ so với seed đó)
    fs, ms = full.get("seeds"), m.get("seeds")
    if fs and ms and set(ms) <= set(fs):
        ranks = [full["ranks"][fs.index(sd)] for sd in ms]
        return per_user_metrics(ranks)
    return full["user_hr"], full["user_nd"]

def ablation_table(full_label, rows_labels, extra=None):
    full = byname[full_label]
    out = []
    for lab in rows_labels:
        m = extra[lab] if (extra and lab in extra) else get_mine(lab)
        if m is None:
            continue
        f_hr, f_nd = matched_full(full, m)
        d_nd, ci = paired_bootstrap(m["user_nd"], f_nd)
        d_hr, _ = paired_bootstrap(m["user_hr"], f_hr)
        verdict = "giảm" if ci[1] < 0 else ("tăng" if ci[0] > 0 else "không phân biệt được")
        out.append({"Biến thể": lab, "Số seed": m["n_seeds"], "HR@10": m["HR"], "NDCG@10": m["ND"],
                    "NDCG@10 đầy đủ (cùng seed)": float(f_nd.mean()),
                    "Δ HR@10 so với đầy đủ": d_hr, "Δ NDCG@10 so với đầy đủ": d_nd,
                    "CI95 Δ NDCG@10": f"[{ci[0]:+.4f}, {ci[1]:+.4f}]", "Nhận xét": verdict})
    out.append({"Biến thể": full_label + "  [ĐẦY ĐỦ]", "Số seed": full["n_seeds"], "HR@10": full["HR"],
                "NDCG@10": full["ND"], "NDCG@10 đầy đủ (cùng seed)": full["ND"], "Δ HR@10 so với đầy đủ": 0.0, "Δ NDCG@10 so với đầy đủ": 0.0,
                "CI95 Δ NDCG@10": "-", "Nhận xét": f"std NDCG@10 giữa seed = {full['ND_std']:.4f}"})
    return pd.DataFrame(out)

if RUN_ABLATIONS:
    sas = byname["SASRec"]
    print("===== 4.3.4.8a  Gỡ thành phần của SASRec ĐA HÀNH VI (so với MB-SASRec đầy đủ) =====")
    print("(SASRec view-only = kết quả sẵn có của nhóm; gỡ nhúng hành vi, gỡ sự kiện addtocart/transaction)")
    abl_a = ablation_table("MB-SASRec (add)",
        ["SASRec (all events, no beh emb)", "MB-SASRec (concat)", "MB-SASRec (view+addtocart)",
         "MB-SASRec (view+transaction)", "SASRec"], extra={"SASRec": sas})
    print(abl_a.round(4).to_string(index=False))
    print("\n===== 4.3.4.8b  Gỡ thành phần của HSTU (so với HSTU đầy đủ) =====")
    abl_b = ablation_table("HSTU", ["HSTU (all events, no beh emb)", "HSTU (view-only)", "HSTU (no rab)", "HSTU (no gate)"])
    print(abl_b.round(4).to_string(index=False))
    abl_a.to_csv(os.path.join(RESULTS_DIR, "ml3_ablation_mbsasrec.csv"), index=False, encoding="utf-8-sig")
    abl_b.to_csv(os.path.join(RESULTS_DIR, "ml3_ablation_hstu.csv"), index=False, encoding="utf-8-sig")
